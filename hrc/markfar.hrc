<?xml version="1.0" encoding="UTF-8"?>
<!--
  MarkFar: colours code blocks in the MarkFar preview through Colorer.
  The preview is a temporary *.mfview file. MarkFar frames each fenced code
  block as

    ── <type> ─────
    code line
    » continuation of a wrapped code line
    ───────────────

  where <type> is a Colorer type name. Inside lists and quotes the lines
  carry the list indent or the quote bar "│ " in front. Each block below hands its body to
  that type's scheme. Adding a language is one block line and one scheme line.
-->
<hrc version="take5" xmlns="http://colorer.sf.net/2003/hrc"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://colorer.sf.net/2003/hrc http://colorer.sf.net/2003/hrc.xsd">

<prototype name="markfar" group="other" description="MarkFar preview">
  <filename weight="10">/\.mfview$/i</filename>
</prototype>

<type name="markfar">
  <import type="def"/>

  <region name="Frame" parent="def:Comment"/>
  <region name="Wrap" parent="def:Comment"/>

  <scheme name="Wrap">
    <regexp match="/^[\s│]*(» )/" region1="Wrap"/>
  </scheme>

  <scheme name="code-sql"><inherit scheme="Wrap"/><inherit scheme="sql:sql"/></scheme>
  <scheme name="code-csharp"><inherit scheme="Wrap"/><inherit scheme="csharp:csharp"/></scheme>
  <scheme name="code-python"><inherit scheme="Wrap"/><inherit scheme="python:python"/></scheme>
  <scheme name="code-jScript"><inherit scheme="Wrap"/><inherit scheme="jScript:jScript"/></scheme>
  <scheme name="code-json"><inherit scheme="Wrap"/><inherit scheme="json:json"/></scheme>
  <scheme name="code-powershell"><inherit scheme="Wrap"/><inherit scheme="powershell:powershell"/></scheme>
  <scheme name="code-yaml"><inherit scheme="Wrap"/><inherit scheme="yaml:yaml"/></scheme>
  <scheme name="code-xml"><inherit scheme="Wrap"/><inherit scheme="xml:xml"/></scheme>
  <scheme name="code-html"><inherit scheme="Wrap"/><inherit scheme="html:html"/></scheme>
  <scheme name="code-shell"><inherit scheme="Wrap"/><inherit scheme="shell:shell"/></scheme>
  <scheme name="code-cpp"><inherit scheme="Wrap"/><inherit scheme="cpp:cpp"/></scheme>
  <scheme name="code-c"><inherit scheme="Wrap"/><inherit scheme="c:c"/></scheme>
  <scheme name="code-java"><inherit scheme="Wrap"/><inherit scheme="java:java"/></scheme>
  <scheme name="code-css"><inherit scheme="Wrap"/><inherit scheme="css:css"/></scheme>
  <scheme name="code-Batch"><inherit scheme="Wrap"/><inherit scheme="Batch:Batch"/></scheme>
  <!-- A markdown code block may itself contain fenced code (an example of
       Markdown source): colour those inner blocks by their language, the
       rest by Colorer's markdown scheme. -->
  <region name="MdFence" parent="Frame"/>
  <scheme name="code-markdown">
    <inherit scheme="Wrap"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:sql|tsql|plsql)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-sql" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:cs|csharp|c#)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-csharp" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:py|python)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-python" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:js|javascript|jsx|mjs|ts|typescript|tsx)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-jScript" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:json|jsonc)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-json" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:ps|ps1|powershell|pwsh)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-powershell" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:yaml|yml)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-yaml" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:xml|xaml|csproj|svg)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-xml" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:html|htm)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-html" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:sh|bash|shell|zsh)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-shell" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:cpp|c\+\+|cc|cxx|hpp)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-cpp" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:c|h)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-c" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:java)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-java" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:css)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-css" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:bat|cmd|batch)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-Batch" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:diff|patch)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-diff" region00="Frame" region10="Frame"/>
    <block start="/^[\s│]*(?{MdFence}`{3,}|\~{3,})\s*(?:go|golang)(?:\s.*)?$/i" end="/^[\s│]*(\y{MdFence})\s*$/" scheme="code-go" region00="Frame" region10="Frame"/>
    <inherit scheme="markdown:markdown"/>
  </scheme>
  <scheme name="code-diff"><inherit scheme="Wrap"/><inherit scheme="diff:diff"/></scheme>
  <scheme name="code-go"><inherit scheme="Wrap"/><inherit scheme="go:go"/></scheme>

  <scheme name="markfar">
    <block start="/^.*?(── sql ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-sql" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── csharp ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-csharp" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── python ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-python" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── jScript ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-jScript" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── json ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-json" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── powershell ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-powershell" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── yaml ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-yaml" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── xml ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-xml" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── html ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-html" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── shell ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-shell" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── cpp ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-cpp" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── c ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-c" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── java ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-java" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── css ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-css" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── Batch ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-Batch" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── markdown ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-markdown" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── diff ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-diff" region00="Frame" region10="Frame"/>
    <block start="/^.*?(── go ─+)$/" end="/^[\s│]*(─+)$/" scheme="code-go" region00="Frame" region10="Frame"/>
  </scheme>
</type>
</hrc>
